function _renderAttachments(container, attachments, row) {
  const issueKey = row.tracker.jira_key;

  // Attachments list
  const listHtml = (!attachments || attachments.length === 0)
    ? '<div class="jira-pane-status" id="jira-attachments-list-' + _esc(issueKey) + '">No attachments.</div>'
    : `<div id="jira-attachments-list-${_esc(issueKey)}">
        ${attachments.map(a => {
          const base = (APP_CONFIG.jiraBaseUrl || '').replace(/\/+$/, '');
          const downloadUrl = `${base}/secure/attachment/${encodeURIComponent(a.id)}/${encodeURIComponent(a.filename || '')}`;
          return `
            <div class="jira-attachment-row">
              <div class="jira-meta-icon">${ATTACHMENT_ICON}</div>
              <div class="jira-attachment-info">
                <span class="jira-attachment-filename">${_esc(a.filename || 'Untitled')}</span>
                <span class="jira-attachment-meta">${_esc(_formatSize(a.size))} · ${_esc(a.author || 'Unknown')} · ${_esc(_formatDate(a.created))}</span>
              </div>
              <a href="${_esc(downloadUrl)}" target="_blank" rel="noopener"
                 class="jira-attachment-download" title="Download ${_esc(a.filename || '')}">
                ${DOWNLOAD_ICON}
              </a>
            </div>
          `;
        }).join('')}
      </div>`;

  // Upload area
  container.innerHTML = `
    ${listHtml}
    <div class="jira-add-attachment">
      <div class="jira-drop-zone" id="jira-drop-zone-${_esc(issueKey)}">
        <input type="file" id="jira-file-input-${_esc(issueKey)}" multiple />
        <div class="jira-drop-zone-icon">${ATTACHMENT_ICON}</div>
        <div class="jira-drop-zone-label">Click to browse or drag & drop files here</div>
        <div class="jira-drop-zone-sub">Multiple files supported · No type or size restrictions</div>
      </div>
      <div class="jira-selected-files" id="jira-selected-files-${_esc(issueKey)}"></div>
      <div class="jira-add-attachment-actions">
        <button class="jira-attachment-clear-btn"  id="jira-attachment-clear-${_esc(issueKey)}">Clear</button>
        <button class="jira-attachment-upload-btn" id="jira-attachment-upload-${_esc(issueKey)}" disabled>Upload</button>
      </div>
    </div>
  `;

  // DOM refs
  const dropZone   = container.querySelector(`#jira-drop-zone-${_esc(issueKey)}`);
  const fileInput  = container.querySelector(`#jira-file-input-${_esc(issueKey)}`);
  const fileList   = container.querySelector(`#jira-selected-files-${_esc(issueKey)}`);
  const clearBtn   = container.querySelector(`#jira-attachment-clear-${_esc(issueKey)}`);
  const uploadBtn  = container.querySelector(`#jira-attachment-upload-${_esc(issueKey)}`);

  let selectedFiles = [];

  // Update the selected files preview list
  function _updateFileList() {
    uploadBtn.disabled = selectedFiles.length === 0;
    if (selectedFiles.length === 0) {
      fileList.innerHTML = '';
      return;
    }
    fileList.innerHTML = selectedFiles.map(f => `
      <div class="jira-selected-file-item">
        <span class="jira-selected-file-name">${_esc(f.name)}</span>
        <span class="jira-selected-file-size">${_esc(_formatSize(f.size))}</span>
      </div>
    `).join('');
  }

  // File input change
  fileInput.addEventListener('change', function () {
    selectedFiles = Array.from(this.files);
    _updateFileList();
  });

  // Drag and drop
  dropZone.addEventListener('dragover', function (e) {
    e.preventDefault();
    dropZone.classList.add('drag-over');
  });
  dropZone.addEventListener('dragleave', function () {
    dropZone.classList.remove('drag-over');
  });
  dropZone.addEventListener('drop', function (e) {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    selectedFiles = Array.from(e.dataTransfer.files);
    _updateFileList();
  });

  // Clear button
  clearBtn.addEventListener('click', function () {
    selectedFiles = [];
    fileInput.value = '';
    _updateFileList();
  });

  // Upload button
  uploadBtn.addEventListener('click', async function () {
    if (selectedFiles.length === 0) return;

    uploadBtn.disabled  = true;
    uploadBtn.textContent = 'Uploading...';

    const formData = new FormData();
    selectedFiles.forEach(f => formData.append('files', f));

    try {
      const resp = await fetch(
        `/jira/issues/${encodeURIComponent(issueKey)}/attachments`,
        { method: 'POST', body: formData }
      );

      const body = await resp.json().catch(() => ({}));

      if (!resp.ok) {
        throw new Error(body.error || 'Upload failed');
      }

      // Clear selection and invalidate cache
      selectedFiles = [];
      fileInput.value = '';
      row._tabCache.attachments = null;

      // Re-fetch and re-render the full tab (list + upload area)
      await _renderAsyncTab(
        container, row, 'attachments',
        `/jira/issues/${encodeURIComponent(issueKey)}/attachments`,
        (c, data) => _renderAttachments(c, data, row),
      );

      if (typeof Toast !== 'undefined') {
        Toast.success('Files uploaded', `${body.data ? body.data.length : ''} file(s) attached to ${issueKey}`);
      }

    } catch (err) {
      if (typeof Toast !== 'undefined') {
        Toast.error('Upload failed', err.message || 'Unknown error');
      } else {
        alert('Upload failed: ' + err.message);
      }
    } finally {
      uploadBtn.disabled    = false;
      uploadBtn.textContent = 'Upload';
    }
  });
}
